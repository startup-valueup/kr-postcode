---
import SiteLayout from '~/layouts/SiteLayout.astro';
import Crumbs from '~/components/Crumbs.astro';
import { load, num } from '~/lib/data';
const { meta } = load();
const c = meta.counts;
const st = meta.stats ?? {};
const regions = (meta.regions ?? []).map((r: { sido: string }) => r.sido).join(', ');
const rateList = (o: Record<string, number> | undefined) =>
  Object.entries(o ?? {})
    .sort((a, b) => b[1] - a[1])
    .map(([k, v]) => `${k} 약 ${Math.round(v * 100)}%`)
    .join(', ');
---

<SiteLayout metadata={{ title: '데이터 출처·기준일·한계' }}>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-10 prose dark:prose-invert prose-a:text-link max-w-none">
    <div class="not-prose"><Crumbs items={[{ text: '홈', href: '/' }, { text: '데이터 안내' }]} /></div>
    <h1>데이터 출처·기준일·한계</h1>

    <h2>출처와 기준일</h2>
    <table>
      <thead><tr><th>자료</th><th>기준</th><th>용도</th></tr></thead>
      <tbody>
        <tr><td>우체국 우편번호 DB(지역별 주소)</td><td>고시 {meta.notice_date} · 기준 {meta.base_date}</td><td>우편번호별 주소·도로·읍면동 구성</td></tr>
        <tr><td>국가기초구역 도형</td><td>{meta.zone_version}</td><td>경계 지도, 면적</td></tr>
        <tr><td>범위주소·사서함·변경분 DB</td><td>고시 {meta.notice_date}</td><td>검증용 대조 (화면에는 직접 쓰지 않음)</td></tr>
      </tbody>
    </table>

    <h2>현재 수록 범위 (시험판)</h2>
    <p>
      {regions}만 수록되어 있습니다. 우편번호 {num(c.zips_total)}개
      (주소 보유 {num(c.zips_with_address)}개, 도형만 있는 번호 {num(c.zips_total - c.zips_with_address)}개), 주소 {num(c.address_rows)}건을 집계했습니다.
      전국 데이터는 준비 중입니다.
    </p>

    <h2>정확도 등급</h2>
    <ul>
      <li><strong>정확</strong>: 주소·좌표 같은 원자료를 직접 집계한 값 (현재 화면의 모든 값)</li>
      <li><strong>추정</strong>: 읍면동·집계구 통계를 우편번호로 배분한 값 (통계가 추가되면 사용)</li>
      <li><strong>참고</strong>: 상위 지역 값을 준용한 값</li>
    </ul>

    <h2>주소로 찾기는 이렇게 동작합니다</h2>
    <ul>
      <li><strong>건물 일치</strong>: 우체국 우편번호 DB의 건물(도로명+번호, 또는 지번)과 같은 주소를 찾은 경우입니다.</li>
      <li><strong>범위 기준</strong>: 건물은 없지만 우체국 범위주소(참고자료)의 범위 안에 들어가는 경우입니다. 범위주소는 우편번호 DB와 같은 원천에서 만들어진 요약이어서, 둘이 같게 나오는 것이 독립적인 검증은 아닙니다.</li>
      <li>시군구별로 나눈 색인 파일을 브라우저가 내려받아 조회합니다. 입력한 주소는 서버로 보내지 않습니다.</li>
      <li>DB에 없는 신축·미등록 건물, 변경분 DB(2026-10-13 고시) 이후의 변경은 반영하지 못합니다.</li>
      <li>건물명 검색은 DB의 &lsquo;시군구용건물명&rsquo;만 사용합니다.</li>
    </ul>

    <h2>읽을 때 유의할 점</h2>
    <ul>
      <li>비율은 <strong>주소(건물) 건수</strong> 기준입니다. 건물의 크기, 세대수, 인구는 반영되지 않습니다.</li>
      <li>
        우편번호는 시·군·구 안에 있는 경우가 대부분이지만, 읍·면·동은 자주 넘나듭니다. 수록 범위에서 우편번호 중 법정 읍면동 두 곳 이상에 걸친 비율은 {rateList(st.emd8_multi_rate)}입니다. 우편번호 페이지의 &lsquo;읍·면·동
        구성&rsquo;은 리까지 나눈 법정동 기준이라 이보다 걸친 곳이 더 많이 보일 수 있습니다.
      </li>
      <li>읍면동 페이지는 법정동코드 앞 8자리(법정 읍면동) 단위이며, 읍·면의 리는 한 페이지에 목록으로 보여 줍니다. 주민센터가 맡는 행정동 구역과는 다를 수 있습니다.</li>
      <li>우편번호 DB의 <code>행정동명</code>이 빈 주소가 있습니다({rateList(st.hdong_blank_rate)}). 법정동과 같다고 가정하지 않고 &lsquo;(미표기)&rsquo;로 표시합니다.</li>
      <li>우편번호 DB에 옛 법정동코드가 남은 {num(meta.legacy_rows_remapped ?? 0)}행은 새 코드로 매핑해 합쳤습니다. 원인은 확인하지 못했습니다.</li>
      <li>경계 도형은 약 2m로 단순화했고 번호마다 따로 단순화해 이웃 경계에 미세한 틈이나 겹침이 있을 수 있습니다.</li>
      <li>기초구역 도형에는 있으나 주소가 없는 번호가 {num(c.zips_total - c.zips_with_address)}개 있습니다. 이유는 확인하지 못했습니다.</li>
      <li>
        기초구역 도형의 면적 속성이 실제 도형 면적과 {Math.round((st.area_mismatch_threshold ?? 0.05) * 100)}% 넘게 다른 구역이 {num(st.area_mismatch ?? 0)}개 있어, 화면의 면적은 도형에서 계산한 값입니다.
      </li>
    </ul>

    <p class="text-sm">이 사이트는 공식 서비스가 아니며 값은 참고용입니다. 공식 확인은 우체국 및 도로명주소 안내시스템을 이용하세요.</p>
  </section>
</SiteLayout>
